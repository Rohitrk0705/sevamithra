# SevaMithra environment configuration
# Copy this file to .env and edit values. .env is gitignored.

# Ollama configuration — local LLM inference
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b

# LLM call defaults (all optional)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
